@model Dish_BIT247667
@{ ViewData["Title"] = L["EditDish"]; }
<h3>@L["EditDish"]</h3>
<form method="post" class="col-md-6">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label class="form-label">@L["Name"]</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">@L["Price"]</label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">@L["Prep"]</label>
        <input asp-for="PreparationTime" class="form-control" />
        <span asp-validation-for="PreparationTime" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">@L["Category"]</label>
        <select asp-for="DishCategoryId" asp-items="ViewBag.Categories" class="form-select"></select>
        <span asp-validation-for="DishCategoryId" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="IsAvailable" class="form-check-input" />
        <label class="form-check-label">@L["Available"]</label>
    </div>
    <div class="mb-3">
        <label class="form-label">@L["Description"]</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>
    <button class="btn btn-primary">@L["Save"]</button>
    <a class="btn btn-secondary" asp-action="Index">@L["Back"]</a>
</form>