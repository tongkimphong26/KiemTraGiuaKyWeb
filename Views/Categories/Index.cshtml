@model List<DishCategory_BIT247667>
@{ ViewData["Title"] = L["Categories"]; }
<h3>@L["Categories"]</h3>

@if (TempData["Err"] != null)
{
    <div class="alert alert-danger">@TempData["Err"]</div>
}

<a asp-action="Create" class="btn btn-success mb-3">@L["Create"]</a>

<table class="table table-striped align-middle">
    <thead>
        <tr><th>@L["CatName"]</th><th>@L["Description"]</th><th>@L["DishCount"]</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.Name</td>
            <td>@c.Description</td>
            <td>@c.Dishes.Count</td>
            <td class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@c.Id">@L["Edit"]</a>
                <form method="post" asp-action="Delete" asp-route-id="@c.Id">
                    <button class="btn btn-sm btn-outline-danger">@L["Delete"]</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>