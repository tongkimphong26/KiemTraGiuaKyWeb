@model DishCategory_BIT247667
@{ ViewData["Title"] = L["CreateCategory"]; }
<h3>@L["CreateCategory"]</h3>
<form method="post" class="col-md-6">
    <div class="mb-3">
        <label class="form-label">@L["CatName"]</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">@L["Description"]</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>
    <button class="btn btn-primary">@L["Save"]</button>
    <a class="btn btn-secondary" asp-action="Index">@L["Back"]</a>
</form>